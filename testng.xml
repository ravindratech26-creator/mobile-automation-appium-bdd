<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Parallelism is controlled from Maven, not here:  mvn test -Dthreads=2 -Ddevices=emulator-5554,emulator-5556
  (pom.xml passes ${threads} to TestNG as dataproviderthreadcount)
-->
<suite name="Mobile BDD Suite" verbose="1">
    <listeners>
        <!-- Retries failed scenarios retry.count times (common.properties / -Dretry.count) -->
        <listener class-name="com.saucelabs.mobile.listeners.RetryTransformer"/>
    </listeners>
    <test name="Cucumber Scenarios">
        <classes>
            <class name="com.saucelabs.mobile.runners.TestRunner"/>
        </classes>
    </test>
</suite>
